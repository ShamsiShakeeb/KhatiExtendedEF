<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>KhatiExtendedEF</id>
    <version>6.0.7</version>
    <authors>Khati</authors>
    <icon>iconEf.png</icon>
    <readme>README.md</readme>
    <description>This Nuget Can be Use for to Maintain Code First Database Approach. It consumes the necessary libraries of Entity Framework and Provides more maintainability and clean coding inside application development.</description>
    <repository type="git" commit="699761fbafa5c397208429be44d785d83f98e158" />
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="Microsoft.AspNet.Mvc" version="5.3.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.AspNetCore.Identity.EntityFrameworkCore" version="8.0.13" exclude="Build,Analyzers" />
        <dependency id="Microsoft.EntityFrameworkCore" version="8.0.13" exclude="Build,Analyzers" />
        <dependency id="Microsoft.EntityFrameworkCore.SqlServer" version="8.0.13" exclude="Build,Analyzers" />
        <dependency id="Microsoft.EntityFrameworkCore.Sqlite" version="8.0.13" exclude="Build,Analyzers" />
        <dependency id="Microsoft.VisualStudio.Web.CodeGeneration.Design" version="8.0.7" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
